{
  "name": "@yogesharc/thinking-orbs",
  "version": "0.1.1",
  "description": "Well-crafted, animated orb status indicators for AI interfaces: thinking, reasoning, searching, compacting and more. For React or plain JS, with no dependencies.",
  "keywords": [
    "react",
    "ai",
    "agent",
    "status",
    "loader",
    "spinner",
    "orb",
    "animation"
  ],
  "homepage": "https://thinkingorbs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yogesharc/thinking-orbs.git",
    "directory": "packages/thinkingorbs"
  },
  "bugs": "https://github.com/yogesharc/thinking-orbs/issues",
  "author": "Yogesh (https://yogesharc.com)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/orb.d.ts",
      "default": "./dist/orb.js"
    },
    "./vanilla": {
      "types": "./dist/orb-core.d.ts",
      "default": "./dist/orb-core.js"
    },
    "./shapes": {
      "types": "./dist/shapes.d.ts",
      "default": "./dist/shapes.js"
    },
    "./renders": {
      "types": "./dist/renders.d.ts",
      "default": "./dist/renders.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p . && node -e \"const fs = require('fs'); for (const f of fs.readdirSync('dist')) fs.writeFileSync('dist/' + f, fs.readFileSync('dist/' + f, 'utf8').replaceAll('\\\"./orb-core\\\"', '\\\"./orb-core.js\\\"'));\"",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
